# Copy to .env.local and fill in real values. .env.local is gitignored.

# Railway MCP server — account-scoped API token.
# Create at: https://railway.com/account/tokens
RAILWAY_API_TOKEN=

# PostHog (heatmaps, session recordings, product analytics).
# Project token from https://us.posthog.com/project/settings — "Project API Key" (starts with phc_).
# Host defaults to https://us.i.posthog.com; set explicitly if you self-host or use EU cloud.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# From https://analytics.google.com → Admin → Data Streams → Web → Measurement ID.
VITE_PUBLIC_GA_MEASUREMENT_ID=
